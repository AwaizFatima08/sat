  "stem": "A tailor in Faisalabad charges \\(T(n) = 450n + 300\\) rupees to stitch \\(n\\) shirts for a customer. A customer is charged 3,000 rupees. How many shirts did the tailor stitch for this customer?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "6"
  ],
  "solution": [
    "Set \\(450n + 300 = 3{,}000\\).",
    "Subtract 300: \\(450n = 2{,}700\\).",
    "Divide by 450: \\(n = 6\\)."
  ],
  "explanation": null,
  "traps": null,
