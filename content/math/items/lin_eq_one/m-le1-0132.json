  "stem": "If \\(0.15(40 - x) + 0.4x = 9.5\\), what is the value of \\(x\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "14"
  ],
  "solution": [
    "Distribute: \\(6 - 0.15x + 0.4x = 9.5\\), so \\(6 + 0.25x = 9.5\\).",
    "Subtract 6: \\(0.25x = 3.5\\).",
    "Divide by 0.25: \\(x = 14\\)."
  ],
  "explanation": null,
