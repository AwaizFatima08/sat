  "stem": "The point \\((a, 5)\\) lies in the solution set of the inequality \\(3x - 2y \\ge 8\\). What is the least possible value of \\(a\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "6"
  ],
  "solution": [
    "Substitute \\(x = a\\) and \\(y = 5\\): \\(3a - 10 \\ge 8\\).",
    "Add 10: \\(3a \\ge 18\\), so \\(a \\ge 6\\).",
    "The least possible value of \\(a\\) is 6."
  ],
  "explanation": null,
