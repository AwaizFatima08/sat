        "3",
        "216"
      ]
    ]
  },
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "6/5"
  ],
  "solution": [
    "\\(f(0) = a(b)^{0} = a\\), so \\(a = 125\\).",
    "\\(f(3) = 125b^{3} = 216\\), so \\(b^{3} = \\frac{216}{125}\\).",
    "Since \\(b\\) is positive, \\(b = \\frac{6}{5} = 1.2\\)."
  ],
  "verify": "a, b = symbols('a b', positive=True)\nsol = solve([Eq(a, 125), Eq(a*b**3, 216)], [a, b], dict=True)\nassert len(sol) == 1 and sol[0][b] == Rational(6, 5)\nassert [Rational(s) for s in spr_answers] == [Rational(6, 5)]",
