  "stem": "A candle is shaped like a right circular cylinder with a radius of 4 centimeters. The volume of the candle is \\(192\\pi\\) cubic centimeters. What is the height of the candle, in centimeters?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "12"
  ],
  "solution": [
    "\\(V = \\pi r^{2}h\\), so \\(192\\pi = \\pi(4^{2})h = 16\\pi h\\).",
    "\\(h = 192 \\div 16 = 12\\)."
  ],
  "explanation": null,
  "traps": null,
  "verify": "h=symbols('h')\nans=solve(Eq(pi*4**2*h,192*pi),h)[0]\nassert ans==12\nassert Rational(spr_answers[0])==ans\n",
