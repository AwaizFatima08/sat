  "stem": "An aquarium is shaped like a rectangular prism. Inside, it is 50 centimeters long, 30 centimeters wide, and 40 centimeters tall. One liter is equal to 1,000 cubic centimeters. How many liters of water does the aquarium hold when it is completely full?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "60"
  ],
  "solution": [
    "Volume: \\(50 \\cdot 30 \\cdot 40 = 60{,}000\\) cubic centimeters.",
    "Convert: \\(60{,}000 \\div 1{,}000 = 60\\) liters."
  ],
  "explanation": null,
  "traps": null,
