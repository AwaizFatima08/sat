  "verify": "f = [(int(a), int(b)) for a, b in figure['rows']]\nn = sum(b for a, b in f)\nassert n == 10\nr = Rational(sum(a * b for a, b in f), n)\nassert r == Rational(22, 5)\nassert Rational(spr_answers[0]) == r and len(spr_answers) == 1",
