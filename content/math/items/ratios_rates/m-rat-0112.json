  "stem": "A conveyor belt in a warehouse moves boxes at a constant speed of 1.8 meters per second. How many kilometers does a box on the belt travel in 25 minutes? (1 kilometer = 1,000 meters)",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "27/10"
  ],
  "solution": [
    "25 minutes is \\(25 \\cdot 60 = 1{,}500\\) seconds.",
    "Distance: \\(1.8 \\cdot 1{,}500 = 2{,}700\\) meters.",
    "Convert: \\(\\frac{2{,}700}{1{,}000} = 2.7\\) kilometers."
  ],
  "explanation": null,
