  "stem": "A hose fills a water tank at a constant rate of 2.5 gallons per minute. The tank is empty and holds 450 gallons. How many hours does it take the hose to fill the tank?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "3"
  ],
  "solution": [
    "Minutes needed: \\(\\frac{450}{2.5} = 180\\) minutes.",
    "Convert to hours: \\(\\frac{180}{60} = 3\\) hours."
  ],
  "verify": "ans = Rational(450) / Rational('2.5') / 60\nassert ans == 3\nassert len(spr_answers) == 1 and Rational(spr_answers[0]) == ans",
