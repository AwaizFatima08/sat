  "stem": "The ratio of a number to 18 is equal to the ratio of 10 to 12. What is the number?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "15"
  ],
  "solution": [
    "Let the number be \\(n\\). Then \\(\\frac{n}{18} = \\frac{10}{12}\\).",
    "\\(n = \\frac{10 \\cdot 18}{12} = 15\\)."
  ],
