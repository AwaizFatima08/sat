  "stem": "What is the greater of the two solutions to the equation \\((x - 3)^{2} = 4x\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "9"
  ],
  "solution": [
    "Expand: \\(x^{2} - 6x + 9 = 4x\\), so \\(x^{2} - 10x + 9 = 0\\).",
    "Factor: \\((x - 1)(x - 9) = 0\\), so \\(x = 1\\) or \\(x = 9\\). The greater solution is \\(9\\)."
  ],
  "explanation": null,
  "traps": null,
