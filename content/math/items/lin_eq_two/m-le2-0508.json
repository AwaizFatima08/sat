  "stem": "The point \\((a, 5)\\) lies on the graph of \\(3x - 2y = 11\\) in the \\(xy\\)-plane. What is the value of \\(a\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "7"
  ],
  "solution": [
    "Substitute \\(x = a\\) and \\(y = 5\\): \\(3a - 10 = 11\\).",
    "Add 10: \\(3a = 21\\), so \\(a = 7\\)."
  ],
  "explanation": null,
