  "stem": "If \\(2^{a} = 5\\), what is the value of \\(4^{a + 1}\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "100"
  ],
  "solution": [
    "Rewrite: \\(4^{a + 1} = 4^{a} \\cdot 4 = (2^{2})^{a} \\cdot 4 = (2^{a})^{2} \\cdot 4\\).",
    "Substitute \\(2^{a} = 5\\): \\(5^{2} \\cdot 4 = 100\\)."
  ],
  "explanation": null,
  "traps": null,
  "verify": "a = symbols('a', real=True)\nsol = solve(Eq(2**a, 5), a)\nassert len(sol) == 1\nval = simplify(4**(sol[0] + 1))\nassert val == 100\nassert [Rational(v) for v in spr_answers] == [val]",
