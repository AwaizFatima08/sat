  "pool": "paper",
  "stem": "If \\(x^{2} + y^{2} = 20\\) and \\(xy = 8\\), what is the value of \\((x - y)^{2}\\)?",
  "figure": null,
  "answer_type": "spr",
  "choices": null,
  "answer": null,
  "spr_answers": [
    "4"
  ],
  "solution": [
    "Expand: \\((x - y)^{2} = x^{2} - 2xy + y^{2} = (x^{2} + y^{2}) - 2xy\\).",
    "Substitute: \\(20 - 2(8) = 4\\)."
  ],
  "explanation": null,
  "traps": null,
  "verify": "x, y = symbols('x y', real=True)\nsols = solve([x**2 + y**2 - 20, x*y - 8], [x, y], dict=True)\nvals = {simplify((s[x] - s[y])**2) for s in sols}\nassert len(sols) > 0 and vals == {4}\nassert [Rational(v) for v in spr_answers] == [4]",
